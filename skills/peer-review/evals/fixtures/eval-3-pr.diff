+from pathlib import Path
+from jinja2 import Environment, FileSystemLoader, select_autoescape
+from src.shared.email.templates import DEFAULT_CONTEXT
+
+
+class TemplateRenderer:
+    """Shared email template rendering for all services."""
+
+    def __init__(self, template_dir: str | Path | None = None):
+        self.template_dir = Path(template_dir) if template_dir else Path(__file__).parent / "default_templates"
+        self.env = Environment(
+            loader=FileSystemLoader(str(self.template_dir)),
+            autoescape=select_autoescape(["html", "xml"]),
+        )
+
+    def render(
+        self,
+        template_name: str,
+        context: dict | None = None,
+        subject: str = "",
+    ) -> dict:
+        template = self.env.get_template(template_name)
+        merged_context = {**DEFAULT_CONTEXT, **(context or {})}
+        html_body = template.render(**merged_context)
+
+        return {
+            "subject": subject,
+            "html_body": html_body,
+            "text_body": self._strip_html(html_body),
+        }
+
+    def render_string(self, template_string: str, context: dict | None = None) -> str:
+        template = self.env.from_string(template_string)
+        merged_context = {**DEFAULT_CONTEXT, **(context or {})}
+        return template.render(**merged_context)
+
+    @staticmethod
+    def _strip_html(html: str) -> str:
+        import re
+        text = re.sub(r"<[^>]+>", "", html)
+        text = re.sub(r"\n{3,}", "\n\n", text)
+        return text.strip()
