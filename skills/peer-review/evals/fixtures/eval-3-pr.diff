diff --git a/tests/shared/email/test_renderer.py b/tests/shared/email/test_renderer.py
new file mode 100644
index 0000000..f6g7h8i
--- /dev/null
+++ b/tests/shared/email/test_renderer.py
@@ -0,0 +1,55 @@
+import pytest
+from pathlib import Path
+from src.shared.email.renderer import TemplateRenderer
+
+
+@pytest.fixture
+def template_dir(tmp_path):
+    tmpl = tmp_path / "test.html"
+    tmpl.write_text("<h1>Hello {{ name }}</h1><p>From {{ company_name }}</p>")
+    return tmp_path
+
+
+@pytest.fixture
+def renderer(template_dir):
+    return TemplateRenderer(template_dir=template_dir)
+
+
+class TestTemplateRenderer:
+    def test_render_basic_template(self, renderer):
+        result = renderer.render("test.html", {"name": "Alice"}, subject="Hi")
+        assert result["subject"] == "Hi"
+        assert "Alice" in result["html_body"]
+        assert "XOi Technologies" in result["html_body"]
+
+    def test_render_includes_default_context(self, renderer):
+        result = renderer.render("test.html", {"name": "Bob"})
+        assert "XOi Technologies" in result["html_body"]
+
+    def test_render_generates_text_body(self, renderer):
+        result = renderer.render("test.html", {"name": "Charlie"})
+        assert "Charlie" in result["text_body"]
+        assert "<h1>" not in result["text_body"]
+
+    def test_render_string(self, renderer):
+        result = renderer.render_string("Hi {{ name }} from {{ company_name }}", {"name": "Dave"})
+        assert "Dave" in result
+        assert "XOi Technologies" in result
+
+    def test_custom_context_overrides_defaults(self, renderer):
+        result = renderer.render("test.html", {"name": "Eve", "company_name": "TestCo"})
+        assert "TestCo" in result["html_body"]
+        assert "XOi Technologies" not in result["html_body"]
+
+    def test_autoescape_html(self, renderer):
+        result = renderer.render("test.html", {"name": "<script>alert('xss')</script>"})
+        assert "<script>" not in result["html_body"]
+        assert "&lt;script&gt;" in result["html_body"]
