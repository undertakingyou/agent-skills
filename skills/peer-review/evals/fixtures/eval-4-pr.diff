diff --git a/tests/scheduling/test_availability.py b/tests/scheduling/test_availability.py
index d4e5f6g..h7i8j9k 100644
--- a/tests/scheduling/test_availability.py
+++ b/tests/scheduling/test_availability.py
@@ -30,3 +30,31 @@ class TestAvailability:

         assert len(slots) == 9  # 8am-5pm = 9 one-hour slots
         assert all("start" in s and "end" in s for s in slots)
+
+    def test_dst_spring_forward(self, service, mock_repo):
+        """March 9, 2025 — clocks spring forward at 2am EST -> 3am EDT.
+        Business hours should still be 8am-5pm local (EDT on this day)."""
+        mock_repo.get_appointments.return_value = []
+
+        slots = service.get_available_slots(
+            technician_id="tech-1",
+            date_str="2025-03-09",
+            tz_name="America/New_York",
+        )
+
+        # Should still get 9 slots: 8am-5pm EDT
+        assert len(slots) == 9
+
+    def test_availability_respects_user_timezone(self, service, mock_repo):
+        """A Pacific user should get slots in PT, not ET."""
+        mock_repo.get_appointments.return_value = []
+
+        slots = service.get_available_slots(
+            technician_id="tech-1",
+            date_str="2025-06-15",
+            tz_name="America/Los_Angeles",
+        )
+
+        assert len(slots) == 9
+        # First slot should be 8am Pacific = 15:00 UTC in summer
+        first_start = slots[0]["start"]
+        assert "15:00:00" in first_start
