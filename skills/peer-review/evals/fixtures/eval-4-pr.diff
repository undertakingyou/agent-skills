+def business_hours_range(date: datetime, tz: ZoneInfo) -> tuple[datetime, datetime]:
+    local_date = date.astimezone(tz)
+    start = local_date.replace(hour=8, minute=0, second=0, microsecond=0)
+    end = local_date.replace(hour=17, minute=0, second=0, microsecond=0)
     return start, end
