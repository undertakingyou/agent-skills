@@ -45,3 +45,31 @@ class WorkOrderRepository:
         return self.session.query(WorkOrder).filter(
             WorkOrder.tenant_id == tenant_id
         ).all()
+
+    def get_by_ids(self, work_order_ids: list[str], tenant_id: str) -> list[WorkOrder]:
+        return self.session.query(WorkOrder).filter(
+            WorkOrder.id.in_(work_order_ids),
+            WorkOrder.tenant_id == tenant_id,
+            WorkOrder.deleted_at.is_(None),
+        ).all()
+
+    def bulk_archive(self, work_orders: list[WorkOrder]) -> None:
+        for wo in work_orders:
+            wo.status = "archived"
+            wo.archived_at = datetime.utcnow()
+        self.session.flush()
