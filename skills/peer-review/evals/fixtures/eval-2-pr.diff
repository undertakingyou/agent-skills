     def __init__(self, repository: EquipmentRepository):
         self.repository = repository

+    def search(
+        self,
+        tenant_id: str,
+        query: str | None = None,
+        equipment_type: str | None = None,
+        manufacturer: str | None = None,
+        is_active: bool | None = None,
+        page: int = 1,
+        page_size: int = 25,
+    ) -> EquipmentSearchResponse:
+        results, total = self.repository.search(
+            tenant_id=tenant_id,
+            query=query,
+            equipment_type=equipment_type,
+            manufacturer=manufacturer,
+            is_active=is_active,
+            page=page,
+            page_size=page_size,
+        )
+
+        return EquipmentSearchResponse(
+            data=[EquipmentOutput.model_validate(r) for r in results],
+            meta=PaginationMeta(
+                page=page,
+                page_size=page_size,
+                total_pages=math.ceil(total / page_size) if total > 0 else 1,
+            ),
+        )
