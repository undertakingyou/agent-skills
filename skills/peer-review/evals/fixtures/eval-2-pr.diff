 from sqlalchemy.orm import Session
 from src.equipment.models import Equipment
+from sqlalchemy import or_, func


 class EquipmentRepository:
@@ -18,3 +19,54 @@ class EquipmentRepository:
         return self.session.query(Equipment).filter(
             Equipment.tenant_id == tenant_id
         ).all()
+
+    def search(
+        self,
+        tenant_id: str,
+        query: str | None = None,
+        equipment_type: str | None = None,
+        manufacturer: str | None = None,
+        is_active: bool | None = None,
+        page: int = 1,
+        page_size: int = 25,
+    ) -> tuple[list[Equipment], int]:
+        q = self.session.query(Equipment).filter(
+            Equipment.tenant_id == tenant_id,
+            Equipment.deleted_at.is_(None),
+        )
+
+        if query:
+            search_term = f"%{query}%"
+            q = q.filter(
+                or_(
+                    Equipment.name.ilike(search_term),
+                    Equipment.model_number.ilike(search_term),
+                )
+            )
+
+        if equipment_type:
+            q = q.filter(Equipment.equipment_type == equipment_type)
+
+        if manufacturer:
+            q = q.filter(Equipment.manufacturer == manufacturer)
+
+        if is_active is not None:
+            q = q.filter(Equipment.is_active == is_active)
+
+        total = q.count()
+        offset = (page - 1) * page_size
+        results = q.offset(offset).limit(page_size).all()
+
+        return results, total
