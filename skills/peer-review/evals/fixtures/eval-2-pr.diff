diff --git a/tests/equipment/test_search.py b/tests/equipment/test_search.py
new file mode 100644
index 0000000..a1b2c3d
--- /dev/null
+++ b/tests/equipment/test_search.py
@@ -0,0 +1,78 @@
+import pytest
+from unittest.mock import MagicMock
+from src.equipment.service import EquipmentService
+
+
+@pytest.fixture
+def mock_repo():
+    return MagicMock()
+
+
+@pytest.fixture
+def service(mock_repo):
+    return EquipmentService(repository=mock_repo)
+
+
+class TestEquipmentSearch:
+    def test_search_by_name(self, service, mock_repo):
+        equip = MagicMock(name="Carrier AC Unit", model_number="38AUZ")
+        mock_repo.search.return_value = ([equip], 1)
+
+        result = service.search(tenant_id="t1", query="carrier")
+
+        mock_repo.search.assert_called_once()
+        assert len(result.data) == 1
+
+    def test_search_with_type_filter(self, service, mock_repo):
+        equip = MagicMock(equipment_type="HVAC")
+        mock_repo.search.return_value = ([equip], 1)
+
+        result = service.search(
+            tenant_id="t1", equipment_type="HVAC"
+        )
+
+        assert len(result.data) == 1
+
+    def test_empty_search_returns_all(self, service, mock_repo):
+        items = [MagicMock() for _ in range(3)]
+        mock_repo.search.return_value = (items, 3)
+
+        result = service.search(tenant_id="t1")
+
+        assert len(result.data) == 3
+
+    def test_pagination_metadata(self, service, mock_repo):
+        mock_repo.search.return_value = ([], 75)
+
+        result = service.search(tenant_id="t1", page=2, page_size=25)
+
+        assert result.meta.page == 2
+        assert result.meta.total_pages == 3
+
+    def test_active_filter(self, service, mock_repo):
+        equip = MagicMock(is_active=True)
+        mock_repo.search.return_value = ([equip], 1)
+
+        result = service.search(tenant_id="t1", is_active=True)
+
+        assert len(result.data) == 1
