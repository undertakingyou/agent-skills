--- /dev/null
+++ b/scheduling/src/dispatch/queries/certifications.ts
@@ -0,0 +1,22 @@
+import { pool } from "../../../certifications/src/db/connection";
+
+interface CertRow {
+  technician_id: string;
+  cert_type: string;
+  expires_at: string;
+}
+
+export async function getTechCertifications(
+  technicianIds: string[]
+): Promise<CertRow[]> {
+  const placeholders = technicianIds.map((_, i) => `$${i + 1}`).join(", ");
+  const result = await pool.query(
+    `SELECT technician_id, cert_type, expires_at
+     FROM certifications.technician_certs
+     WHERE technician_id IN (${placeholders})
+       AND deleted_at IS NULL`,
+    technicianIds
+  );
+  return result.rows;
+}
diff --git a/scheduling/src/dispatch/hooks/useCertStatus.ts b/scheduling/src/dispatch/hooks/useCertStatus.ts
new file mode 100644
index 0000000..b2c3d4e
--- /dev/null
+++ b/scheduling/src/dispatch/hooks/useCertStatus.ts
@@ -0,0 +1,48 @@
+import { useQuery } from "@tanstack/react-query";
+import { getTechCertifications } from "../queries/certifications";
+
+type CertStatus = "valid" | "expiring" | "expired";
+
+interface CertStatusResult {
+  status: CertStatus;
+  worstCert?: string;
+  daysUntilExpiry?: number;
+}
+
+function computeStatus(expiresAt: string): CertStatus {
+  const now = new Date();
+  const expiry = new Date(expiresAt);
+  const daysLeft = Math.floor(
+    (expiry.getTime() - now.getTime()) / (1000 * 60 * 60 * 24)
+  );
+
+  if (daysLeft < 0) return "expired";
+  if (daysLeft <= 30) return "expiring";
+  return "valid";
+}
+
+const STATUS_PRIORITY: Record<CertStatus, number> = {
+  expired: 0,
+  expiring: 1,
+  valid: 2,
+};
+
+export function useCertStatus(technicianId: string): CertStatusResult {
+  const { data: certs } = useQuery({
+    queryKey: ["certStatus", technicianId],
+    queryFn: () => getTechCertifications([technicianId]),
+  });
+
+  if (!certs || certs.length === 0) {
+    return { status: "valid" };
+  }
+
+  let worst: CertStatusResult = { status: "valid" };
+
+  for (const cert of certs) {
+    const status = computeStatus(cert.expires_at);
+    if (STATUS_PRIORITY[status] < STATUS_PRIORITY[worst.status]) {
+      worst = { status, worstCert: cert.cert_type };
+    }
+  }
+
+  return worst;
+}
diff --git a/scheduling/src/dispatch/components/CertBadge.tsx b/scheduling/src/dispatch/components/CertBadge.tsx
