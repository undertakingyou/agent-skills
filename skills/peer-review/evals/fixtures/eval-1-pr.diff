@@ -0,0 +1,30 @@
+import React from "react";
+
+type CertStatus = "valid" | "expiring" | "expired";
+
+const STATUS_COLORS: Record<CertStatus, string> = {
+  valid: "#22c55e",
+  expiring: "#eab308",
+  expired: "#ef4444",
+};
+
+const STATUS_LABELS: Record<CertStatus, string> = {
+  valid: "Certified",
+  expiring: "Expiring Soon",
+  expired: "Expired",
+};
+
+interface CertBadgeProps {
+  status: CertStatus;
+}
+
+export function CertBadge({ status }: CertBadgeProps) {
+  return (
+    <span
+      style={{
+        backgroundColor: STATUS_COLORS[status],
+        color: "white",
+        padding: "2px 8px",
+        borderRadius: "4px",
+        fontSize: "12px",
+      }}
+    >
+      {STATUS_LABELS[status]}
+    </span>
+  );
+}
