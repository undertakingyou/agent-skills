{
  "eval_id": 0,
  "eval_name": "bulk-archive-with-ticket",
  "prompt": "Peer review this PR against its ticket. Ticket data is in fixtures/eval-0-ticket.json, PR metadata in fixtures/eval-0-pr-meta.json, and the diff in fixtures/eval-0-pr.diff. Skip the Jira/GitHub fetch and branch checkout steps — use these files directly.",
  "assertions": [
    {"name": "has-required-headers", "type": "contains_all", "values": ["Ticket Fulfillment", "Highlights", "Findings", "What I Verified", "Summary"]},
    {"name": "has-requirements-table", "type": "regex", "pattern": "\\|.*Requirement.*\\|.*Status.*\\|"},
    {"name": "references-ticket", "type": "contains", "value": "DEMO-101"},
    {"name": "references-pr", "type": "contains", "value": "542"},
    {"name": "cites-file-paths", "type": "regex", "pattern": "[a-z_/]+\\.(py|ts|js|yaml|yml|json)"},
    {"name": "uses-severity-levels", "type": "contains_any", "values": ["Critical", "Important", "Minor"]},
    {"name": "has-fulfillment-verdict", "type": "regex", "pattern": "(?i)(all|fully|partially|unmet|addressed|criteria)"},
    {"name": "has-highlights", "type": "regex", "pattern": "(?s)### Highlights.*?\\n- .+"}
  ]
}
